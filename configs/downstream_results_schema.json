{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CFNN downstream confirmatory evaluation record",
  "type": "object",
  "required": [
    "stage",
    "stage_role",
    "task",
    "task_role",
    "problem_type",
    "family",
    "target_budget",
    "data_seed",
    "init_seed",
    "candidate_key",
    "config",
    "actual_parameters",
    "optimizer",
    "best_step",
    "optimizer_steps",
    "validation_score",
    "status",
    "curve",
    "training_wall_seconds",
    "total_wall_seconds",
    "device",
    "dataset",
    "source_manifest_sha256",
    "test_metrics",
    "primary_metric_name",
    "primary_metric_value"
  ],
  "properties": {
    "stage": {"enum": ["confirmatory_evaluation", "confirmatory_seed_extension"]},
    "stage_role": {"const": "confirmatory_test"},
    "task": {"type": "string", "minLength": 1},
    "task_role": {"type": "string", "minLength": 1},
    "problem_type": {"enum": ["regression", "complex_regression", "classification"]},
    "family": {"type": "string", "minLength": 1},
    "target_budget": {"type": "integer", "minimum": 1},
    "data_seed": {"type": "integer"},
    "init_seed": {"type": "integer"},
    "candidate_key": {"type": "string"},
    "config": {"type": "object"},
    "actual_parameters": {"type": "integer", "minimum": 1},
    "optimizer": {
      "type": "object",
      "required": ["key", "lr", "weight_decay"],
      "properties": {
        "key": {"type": "string"},
        "lr": {"type": "number", "exclusiveMinimum": 0},
        "weight_decay": {"type": "number", "minimum": 0}
      }
    },
    "best_step": {"type": "integer", "minimum": 0},
    "optimizer_steps": {"type": "integer", "minimum": 0},
    "validation_score": {"type": ["number", "null"]},
    "status": {"type": "string"},
    "curve": {"type": "array", "items": {"type": "object"}},
    "training_wall_seconds": {"type": "number", "minimum": 0},
    "total_wall_seconds": {"type": "number", "minimum": 0},
    "peak_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
    "device": {"type": "string"},
    "dataset": {"type": "object"},
    "model_metadata": {"type": "object"},
    "source_manifest_sha256": {"type": ["string", "null"]},
    "test_metrics": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"type": "string"}}
    },
    "primary_metric_name": {"enum": ["complex_nrmse", "nrmse", "auroc"]},
    "primary_metric_value": {"type": ["number", "null"]},
    "selection_path": {"type": "string"},
    "protocol_extension_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
