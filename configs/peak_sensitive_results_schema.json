{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CFNN peak-sensitive extension tuning and evaluation record",
  "type": "object",
  "required": [
    "protocol_key",
    "protocol_mode",
    "smoke_root_marker",
    "config_sha256",
    "stage",
    "stage_role",
    "phase",
    "scientific_role",
    "test_visibility",
    "task",
    "task_role",
    "problem_type",
    "family",
    "target_budget",
    "data_seed",
    "init_seed",
    "candidate_key",
    "config",
    "actual_parameters",
    "optimizer",
    "best_step",
    "optimizer_steps",
    "validation_score",
    "status",
    "curve",
    "training_wall_seconds",
    "total_wall_seconds",
    "device",
    "dataset",
    "source_manifest_sha256",
    "protocol_sha256",
    "window_spec",
    "validation_resonance_nrmse",
    "validation_global_nrmse",
    "initialization_mode",
    "gradient_clip_events",
    "gradient_clip_rate",
    "gradient_clip_threshold",
    "training_min_steps",
    "training_max_steps",
    "training_patience",
    "training_checkpoints",
    "training_batch_size",
    "batch_seed",
    "validation_interval",
    "validation_evaluations",
    "tuning_seed",
    "frf_density",
    "candidate_manifest_sha256"
  ],
  "properties": {
    "protocol_mode": {"enum": ["production", "smoke"]},
    "smoke_root_marker": {"type": ["string", "null"]},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage": {"enum": ["peak_sensitive_evaluation", "peak_sensitive_tuning"]},
    "protocol_key": {"const": "cfnn-peak-sensitive-extension-2.0.0"},
    "stage_role": {"enum": ["validation_only", "confirmatory_test"]},
    "phase": {"enum": ["screening", "convergence", "evaluation"]},
    "scientific_role": {"enum": ["tuning", "evaluation"]},
    "test_visibility": {"enum": ["sealed", "opened"]},
    "task": {
      "enum": [
        "controlled_fano",
        "microwave_fano",
        "microstrip_resonator",
        "aluminium_frf",
        "figshare_battery_eis",
        "hybrid_supercapacitor_eis"
      ]
    },
    "task_role": {
      "enum": ["controlled_mechanism", "fixed_measured", "independent_eis_extension"]
    },
    "problem_type": {"const": "complex_regression"},
    "family": {
      "enum": [
        "CFNN",
        "MLP",
        "Fourier-feature MLP",
        "Gaussian RBF",
        "KAN",
        "Local nested CF control",
        "Rational activation NN",
        "SIREN"
      ]
    },
    "target_budget": {"enum": [128, 256, 512, 1024]},
    "data_seed": {"type": "integer"},
    "init_seed": {"type": "integer"},
    "candidate_key": {"type": "string"},
    "config": {"type": "object"},
    "actual_parameters": {"type": "integer", "minimum": 1},
    "optimizer": {
      "type": "object",
      "required": ["key", "lr", "weight_decay"],
      "properties": {
        "key": {"type": "string"},
        "lr": {"type": "number", "exclusiveMinimum": 0},
        "weight_decay": {"type": "number", "minimum": 0}
      }
    },
    "best_step": {"type": "integer", "minimum": 0},
    "optimizer_steps": {"type": "integer", "minimum": 0},
    "validation_score": {"type": ["number", "null"]},
    "status": {"type": "string"},
    "curve": {"type": "array", "items": {"type": "object"}},
    "training_wall_seconds": {"type": "number", "minimum": 0},
    "total_wall_seconds": {"type": "number", "minimum": 0},
    "peak_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
    "device": {"type": "string"},
    "dataset": {
      "type": "object",
      "required": ["curve_id", "scientific_role", "test_access"],
      "properties": {
        "curve_id": {"type": "string", "minLength": 1},
        "scientific_role": {"enum": ["tuning", "evaluation"]},
        "test_access": {
          "enum": ["sealed_for_validation_only_stage", "opened_confirmatory_test"]
        }
      },
      "additionalProperties": true
    },
    "model_metadata": {"type": "object"},
    "source_manifest_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "test_metrics": {
      "type": "object",
      "required": [
        "status",
        "complex_nrmse",
        "global_complex_nrmse",
        "resonance_window_complex_nrmse",
        "phase_mae_rad",
        "strongest_feature_frequency_error",
        "missed_feature_rate",
        "false_feature_rate",
        "quality_factor_or_bandwidth_error",
        "numerical_failure_rate",
        "underfit_rate",
        "dominant_relaxation_frequency_error",
        "kramers_kronig_consistency_proxy"
        ,"underfit_criterion"
        ,"metric_applicability"
      ],
      "properties": {
        "status": {"type": "string"},
        "complex_nrmse": {"type": ["number", "null"]},
        "global_complex_nrmse": {"type": ["number", "null"]},
        "resonance_window_complex_nrmse": {"type": ["number", "null"]},
        "phase_mae_rad": {"type": ["number", "null"]},
        "strongest_feature_frequency_error": {"type": ["number", "null"]},
        "missed_feature_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "false_feature_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "quality_factor_or_bandwidth_error": {"type": ["number", "null"]},
        "numerical_failure_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "underfit_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "dominant_relaxation_frequency_error": {"type": ["number", "null"]},
        "kramers_kronig_consistency_proxy": {"type": ["number", "null"]},
        "underfit_criterion": {"const": "validation_global_nrmse_ge_1.0"},
        "metric_applicability": {
          "type": "object",
          "required": [
            "quality_factor_or_bandwidth_error",
            "dominant_relaxation_frequency_error",
            "kramers_kronig_consistency_proxy",
            "underfit_rate"
          ],
          "additionalProperties": false,
          "properties": {
            "quality_factor_or_bandwidth_error": {"$ref": "#/$defs/applicability"},
            "dominant_relaxation_frequency_error": {"$ref": "#/$defs/applicability"},
            "kramers_kronig_consistency_proxy": {"$ref": "#/$defs/applicability"},
            "underfit_rate": {"$ref": "#/$defs/applicability"}
          }
        }
      },
      "additionalProperties": true
    },
    "primary_metric_name": {"const": "resonance_window_complex_nrmse"},
    "primary_metric_value": {"type": ["number", "null"]},
    "selection_path": {"type": "string"},
    "protocol_extension_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "window_spec": {
      "type": "object",
      "required": ["task", "axis_space", "intervals", "source_role", "status", "detector"],
      "properties": {
        "task": {
          "enum": [
            "controlled_fano",
            "microwave_fano",
            "microstrip_resonator",
            "aluminium_frf",
            "figshare_battery_eis",
            "hybrid_supercapacitor_eis"
          ]
        },
        "axis_space": {"enum": ["linear", "log10_frequency"]},
        "intervals": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "number"},
              {"type": "number"}
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "source_role": {
          "enum": ["train_validation", "generator_metadata", "no_identifiable_feature"]
        },
        "status": {"enum": ["ok", "no_identifiable_feature"]},
        "detector": {"type": "object"}
      }
    },
    "validation_resonance_nrmse": {"type": ["number", "null"]},
    "validation_global_nrmse": {"type": ["number", "null"]},
    "initialization_mode": {"enum": ["fixed", "numerator_scaled"]},
    "gradient_clip_events": {"type": "integer", "minimum": 0},
    "gradient_clip_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "gradient_clip_threshold": {"type": "number", "exclusiveMinimum": 0},
    "training_min_steps": {"type": "integer", "minimum": 1},
    "training_max_steps": {"type": "integer", "minimum": 1},
    "training_patience": {"type": "integer", "minimum": 1},
    "training_checkpoints": {
      "type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}
    },
    "training_batch_size": {"type": "integer", "minimum": 1},
    "batch_seed": {"type": "integer"},
    "validation_interval": {"type": "integer", "minimum": 1},
    "validation_evaluations": {"type": "integer", "minimum": 0},
    "tuning_seed": {"type": ["integer", "null"]},
    "frf_density": {"type": ["integer", "null"], "enum": [24, 48, 96, 192, null]},
    "candidate_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_common_budget": {
      "type": ["integer", "null"],
      "enum": [128, 256, 512, 1024, null]
    }
  },
  "$defs": {
    "applicability": {
      "type": "object",
      "required": ["status", "reason"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["applicable", "not_applicable", "unidentifiable"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "$comment": "Draft 2020-12 validates shape; the production semantic validator enforces frozen cross-field values and inventory membership.",
  "allOf": [
    {
      "if": {
        "required": ["stage"],
        "properties": {"stage": {"const": "peak_sensitive_tuning"}}
      },
      "then": {
        "properties": {"stage_role": {"const": "validation_only"}},
        "not": {
          "anyOf": [
            {"required": ["test_metrics"]},
            {"required": ["primary_metric_name"]},
            {"required": ["primary_metric_value"]}
          ]
        }
      }
    },
    {
      "if": {
        "required": ["stage"],
        "properties": {"stage": {"const": "peak_sensitive_evaluation"}}
      },
      "then": {
        "properties": {
          "stage_role": {"const": "confirmatory_test"},
          "selected_common_budget": {"type": "integer", "enum": [128, 256, 512, 1024]}
        },
        "required": [
          "test_metrics",
          "primary_metric_name",
          "primary_metric_value",
          "selected_common_budget",
          "selection_path",
          "selection_sha256"
        ]
      }
    }
  ],
  "additionalProperties": false
}
